; Saber Escaso — cliente Godot
;
; Renderer Forward+ a propósito: es el único que da SDFGI (iluminación global
; en tiempo real) y niebla volumétrica, que son las dos cosas que hacen que
; esto se vea como un diorama iluminado y no como 3D de asset store.

config_version=5

[application]

config/name="Saber Escaso"
config/description="Un valle donde el saber vive en gente que se muere."
run/main_scene="res://escenas/valle.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icono.svg"

[autoload]

; El ajuste de calidad (alto/medio/bajo). Va como autoload porque tiene que
; decidir el nivel ANTES de que valle.gd arme la escena: el pasto y los efectos
; se construyen ya sabiendo en qué máquina están corriendo.
Rendimiento="*res://scripts/rendimiento.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

